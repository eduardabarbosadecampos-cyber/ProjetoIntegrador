<Page x:Class="ProjetoIntegrador.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      Title="PDV Loja"
      Height="850" 
      Width="1400"
      Background="#F3F4F6" HorizontalAlignment="Center" VerticalAlignment="Center">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

         <!--MENU LATERAL--> 
        <Border Background="#0F172A"
             Grid.Column="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                 <!--LOGO--> 
                <Border Background="#111827"
                     Height="90">

                    <StackPanel Orientation="Horizontal"
                             VerticalAlignment="Center"
                             Margin="25,0">

                        <Border Width="50"
                             Height="50"
                             CornerRadius="12"
                             Background="#22C55E">

                            <TextBlock Text="🛒"
                                    FontSize="26"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="PDV LOJA"
                                Foreground="White"
                                FontSize="34"
                                FontWeight="Bold"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                 <!--MENU--> 
                <StackPanel Grid.Row="1"
                         Margin="10,10">

                     <!--BOTÃO--> 
                    <Button x:Name="BtnVendas" Content="🛒 Vendas" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnProdutos" Content="📦 Produtos" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnClientes" Content="👥 Clientes" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnEstoque" Content="🚚 Estoque" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnRelatorios" Content="📊 Relatórios" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnFinanceiro" Content="💲 Financeiro" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnConfiguracoes" Content="⚙️ Configurações" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>

                     <!--ITEM--> 
                </StackPanel>
                 <!--Encerrar sistema--> 
                <Button Margin="0,670,0,0" Grid.Row="1" Grid.RowSpan="2" Background="Red" Click="FecharSistema">

                    <StackPanel Orientation="Horizontal"
                             VerticalAlignment="Center"
                             Margin="30,0">

                        <TextBlock Text="⏻"
                                Foreground="White"
                                FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>

                        <TextBlock Text="Encerrar sistema"
                                Foreground="White"
                                FontSize="20"
                                Margin="15,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

         <!--CONTEÚDO--> 
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--TOPBAR-->
            <Border Background="White"
                 Height="90"
                 BorderBrush="#E5E7EB"
                 BorderThickness="0,0,0,1">

                <Grid Margin="30,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Olá, Eduarda!"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="#111827"/>

                        <TextBlock Text="Bem-vindo ao sistema PDV"
                                FontSize="18"
                                Foreground="#6B7280"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                             Orientation="Horizontal"
                             VerticalAlignment="Center">

                        <Border Background="#DCFCE7"
                             Padding="18,10"
                             CornerRadius="20">

                            <TextBlock Text="● CAIXA ABERTO"
                                    Foreground="#16A34A"
                                    FontWeight="Bold"
                                    FontSize="18"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        
         <!--ESTOQUE-->
        
            <Canvas x:Name="MenuEstoque" Visibility="Collapsed" Grid.RowSpan="2">

                <TextBlock Text="Controle de Estoque"
                   FontSize="24"
                   FontWeight="Bold"
                   Canvas.Left="426"
                   Canvas.Top="95" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                
         <!--Pesquisa--> 
        
                <TextBox x:Name="txtPesquisar"
                 Width="250"
                 Height="30"
                 Canvas.Left="90"
                 Canvas.Top="165" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                
         <!--Botão Pesquisar--> 
        
                <Button x:Name="btnPesquisar"
                Content="Pesquisar"
                Width="100"
                Height="30"
                Background="#D9D9D9"
                Canvas.Left="365"
                Canvas.Top="165"/>

                
         <!--Botão Atualizar Estoque--> 
        
                <Button x:Name="btnAtualizar"
                Content="Atualizar Estoque"
                Width="140"
                Height="30"
                Background="#22C55E"
                Foreground="White"
                FontWeight="Bold"
                Canvas.Left="470"
                Canvas.Top="150" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <DataGrid x:Name="dgEstoque"
                          Width="900"
                          Height="500"
                          Canvas.Left="90"
                          Canvas.Top="243"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" HorizontalAlignment="Left" VerticalAlignment="Top">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Produto"
                                            Binding="{Binding Produto}"
                                            Width="250"/>

                        <DataGridTextColumn Header="Tamanho"
                                            Binding="{Binding Tamanho}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Cor"
                                            Binding="{Binding Cor}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Qtd. Disponível"
                                            Binding="{Binding QuantidadeDisponivel}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="150"/>


                    </DataGrid.Columns>

                </DataGrid>

            </Canvas>


            <Canvas x:Name="MenuRelatorios" Visibility="Collapsed" Grid.Row="1">

                
         <!--Painel Superior--> 
        
                <Border Width="1045"
                Height="200"
                Background="#22C55E"
                CornerRadius="25"
                Canvas.Left="25"
                Canvas.Top="20" HorizontalAlignment="Left" VerticalAlignment="Center">

                    <Canvas>

                        
         <!--Data--> 
        
                        <TextBlock Text="Data"
                           FontSize="26"
                           FontWeight="Bold"
                           Canvas.Left="25"
                           Canvas.Top="25"/>

                        <DatePicker Width="220"
                            Height="45"
                            Canvas.Left="25"
                            Canvas.Top="70"/>

                        
         <!--Produto--> 
        
                        <TextBlock Text="Produto"
                           FontSize="26"
                           FontWeight="Bold"
                           Canvas.Left="300"
                           Canvas.Top="25"/>

                        <ComboBox Width="225"
                          Height="45"
                          Canvas.Left="300"
                          Canvas.Top="70">

                            <ComboBoxItem Content="Todos os Produtos"/>
                            <ComboBoxItem Content="Camisetas"/>
                            <ComboBoxItem Content="Calças"/>
                            <ComboBoxItem Content="Moletons"/>

                        </ComboBox>

                        
         <!--Categoria--> 
        
                        <TextBlock Text="Categoria"
                           FontSize="26"
                           FontWeight="Bold"
                           Canvas.Left="580"
                           Canvas.Top="25"/>

                        <ComboBox Width="193"
                          Height="45"
                          Canvas.Left="580"
                          Canvas.Top="70" HorizontalAlignment="Left" VerticalAlignment="Center">

                            <ComboBoxItem Content="Roupas"/>
                            <ComboBoxItem Content="Masculino"/>
                            <ComboBoxItem Content="Feminino"/>

                        </ComboBox>

                        
         <!--Cliente--> 
        
                        <TextBlock Text="Cliente"
                           FontSize="26"
                           FontWeight="Bold"
                           Canvas.Left="828"
                           Canvas.Top="25" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <ComboBox Width="207"
                          Height="45"
                          Canvas.Left="828"
                          Canvas.Top="70" HorizontalAlignment="Left" VerticalAlignment="Center">

                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Eduarda"/>
                            <ComboBoxItem Content="Maria"/>

                        </ComboBox>

                    </Canvas>

                </Border>

                
         <!--Card Total de Vendas--> 
        
                <Border Width="298"
                Height="200"
                Background="White"
                CornerRadius="20"
                Canvas.Left="45"
                Canvas.Top="330" HorizontalAlignment="Left" VerticalAlignment="Center">

                    <Canvas>

                        <Border Width="258"
                        Height="40"
                        Background="#22C55E"
                        CornerRadius="20"
                        Canvas.Left="25"
                        Canvas.Top="15" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Text="TOTAL DE VENDAS"
                           FontSize="18"
                           FontWeight="Bold"
                           Canvas.Left="75"
                           Canvas.Top="23" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                        <TextBlock x:Name="txtTotalVendas"
                           Text="R$ 0,00"
                           FontSize="40"
                           FontWeight="Bold"
                           Canvas.Left="80"
                           Canvas.Top="90"/>

                    </Canvas>

                </Border>

                
         <!--Card Produto Mais Vendido--> 
        
                <Border Width="298"
                Height="200"
                Background="White"
                CornerRadius="20"
                Canvas.Left="391"
                Canvas.Top="330" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Canvas>

                        <Border Width="263"
                        Height="40"
                        Background="#22C55E"
                        CornerRadius="20"
                        Canvas.Left="25"
                        Canvas.Top="15" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Text="PRODUTO MAIS VENDIDO"
                           FontSize="18"
                           FontWeight="Bold"
                           Canvas.Left="37"
                           Canvas.Top="23"/>

                        <TextBlock x:Name="txtMaisVendido"
                           Text="Camiseta"
                           FontSize="28"
                           FontWeight="Bold"
                           Canvas.Left="80"
                           Canvas.Top="90"/>

                    </Canvas>

                </Border>

                
         <!--Card Quantidade Vendida--> 
        
                <Border Width="298"
                Height="200"
                Background="White"
                CornerRadius="20"
                Canvas.Left="731"
                Canvas.Top="330" HorizontalAlignment="Left" VerticalAlignment="Center">

                    <Canvas>

                        <Border Width="246"
                        Height="40"
                        Background="#22C55E"
                        CornerRadius="20"
                        Canvas.Left="25"
                        Canvas.Top="15" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Text="QUANTIDADE VENDIDA"
                           FontSize="18"
                           FontWeight="Bold"
                           Canvas.Left="47"
                           Canvas.Top="23"/>

                        <TextBlock x:Name="txtQuantidade"
                           Text="0"
                           FontSize="40"
                           FontWeight="Bold"
                           Canvas.Left="135"
                           Canvas.Top="73" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    </Canvas>
                </Border>
            </Canvas>

            
         <!--Financeiro--> 
        
            <Canvas Visibility="Collapsed" Grid.Row="1">

                
         <!--Painel de filtros--> 
        
                <Border Width="1024"
                                Height="140"
                                Background="#22C55E"
                                CornerRadius="25"
                                Canvas.Left="25"
                                Canvas.Top="20" HorizontalAlignment="Left" VerticalAlignment="Center">

                    <Canvas>

                        <TextBlock Text="Período"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Canvas.Left="30"
                                   Canvas.Top="20"/>

                        <DatePicker Width="220"
                                    Height="40"
                                    Canvas.Left="30"
                                    Canvas.Top="60"/>

                        <TextBlock Text="Movimentação"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Canvas.Left="320"
                                   Canvas.Top="20"/>

                        <ComboBox Width="220"
                                    Height="40"
                                    Canvas.Left="320"
                                    Canvas.Top="60">

                            <ComboBoxItem Content="Todas"/>
                            <ComboBoxItem Content="Entradas"/>
                            <ComboBoxItem Content="Saídas"/>

                        </ComboBox>

                        <Button Content="Pesquisar"
                                Width="150"
                                Height="40"
                                Background="White"
                                Canvas.Left="580"
                                Canvas.Top="60"/>

                    </Canvas>

                </Border>

                
         <!--Entradas-->
        

                <Border Width="268"
                        Height="180"
                        Background="White"
                        CornerRadius="20"
                        Canvas.Left="25"
                        Canvas.Top="200" HorizontalAlignment="Left" VerticalAlignment="Center">

                    <Canvas>

                        <Border Width="233"
                                Height="40"
                                Background="#22C55E"
                                CornerRadius="20"
                                Canvas.Left="25"
                                Canvas.Top="15" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Text="ENTRADAS"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Canvas.Left="89"
                                   Canvas.Top="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Text="R$ 0,00"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Canvas.Left="71"
                                   Canvas.Top="90" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    </Canvas>
                </Border>

                
         <!--Saídas--> 
        
                <Border Width="260"
                Height="180"
                Background="White"
                CornerRadius="20"
                Canvas.Left="407"
                Canvas.Top="200" HorizontalAlignment="Left" VerticalAlignment="Top">

                    <Canvas>

                        <Border Width="207"
                        Height="40"
                        Background="#FF6B6B"
                        CornerRadius="20"
                        Canvas.Left="25"
                        Canvas.Top="15" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Text="SAÍDAS"
                           FontSize="20"
                           FontWeight="Bold"
                           Canvas.Left="94"
                           Canvas.Top="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Text="R$ 0,00"
                           FontSize="36"
                           FontWeight="Bold"
                           Canvas.Left="67"
                           Canvas.Top="90" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    </Canvas>

                </Border>

                
         <!--Lucro--> 
        
                <Border Width="245"
                Height="180"
                Background="White"
                CornerRadius="20"
                Canvas.Left="747"
                Canvas.Top="200" HorizontalAlignment="Left" VerticalAlignment="Center">

                    <Canvas>

                        <Border Width="192"
                        Height="40"
                        Background="#00C45F"
                        CornerRadius="20"
                        Canvas.Left="25"
                        Canvas.Top="15" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Text="LUCRO"
                           FontSize="20"
                           FontWeight="Bold"
                           Canvas.Left="90"
                           Canvas.Top="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Text="R$ 0,00"
                           FontSize="36"
                           FontWeight="Bold"
                           Canvas.Left="67"
                           Canvas.Top="90" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    </Canvas>

                </Border>

                
         <!--Tabela--> 
        
                <DataGrid Width="1024"
                  Height="250"
                  Canvas.Left="25"
                  Canvas.Top="420"
                  AutoGenerateColumns="False" HorizontalAlignment="Left" VerticalAlignment="Center">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Data"
                                    Binding="{Binding Data}"
                                    Width="150"/>

                        <DataGridTextColumn Header="Descrição"
                                    Binding="{Binding Descricao}"
                                    Width="350"/>

                        <DataGridTextColumn Header="Tipo"
                                    Binding="{Binding Tipo}"
                                    Width="150"/>

                        <DataGridTextColumn Header="Valor"
                                    Binding="{Binding Valor}"
                                    Width="150"/>

                        <DataGridTextColumn Header="Forma Pagamento"
                                    Binding="{Binding Pagamento}"
                                    Width="250"/>

                    </DataGrid.Columns>

                </DataGrid>



            </Canvas>

        </Grid>
        <ContentControl x:Name="Ctrl" Grid.Column="1" Margin="0,94,0,0"/>
    </Grid>
</Page>

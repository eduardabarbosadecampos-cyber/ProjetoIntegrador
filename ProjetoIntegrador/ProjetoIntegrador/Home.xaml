<Page x:Class="ProjetoIntegrador.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home">

    <Canvas Background="White">
        <Rectangle HorizontalAlignment="Center" Height="74" VerticalAlignment="Top" Width="800" Fill="#FF00BF63"/>
        <Label x:Name="Olá_Cliente" Content="Olá cliente" HorizontalAlignment="Left" Margin="35,6,0,0" VerticalAlignment="Top" FontFamily="Freestyle Script" Height="62" Width="196" FontSize= "50" FontWeight="Bold"/>

        <TabControl HorizontalAlignment="Center" Canvas.Top="74" VerticalAlignment="Top" Height="376" Width="800" SelectionChanged="TabControl_SelectionChanged">

            <TabItem Header="Produtos/Roupas" Width="150" Height="50" FontFamily="Century Gothic" FontSize="16"/>

            <TabItem Header="Clientes" Width="150" Height="50" FontFamily="Century Gothic" FontSize="16"/>

            <TabItem Header="Vendas" Width="150" Height="50" FontFamily="Century Gothic" FontSize="16"/>
            <TabItem Header="Estoque" Width="150" Height="50" FontFamily="Century Gothic" FontSize="16" Margin="0,-1,0,1"/>
            <TabItem Header="Relatórios" Width="150" Height="50" FontFamily="Century Gothic" FontSize="16" Margin="0,-1,0,1"/>

        </TabControl>

    </Canvas>
</Page>

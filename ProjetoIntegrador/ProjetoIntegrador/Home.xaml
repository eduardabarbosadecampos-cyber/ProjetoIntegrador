<Page x:Class="ProjetoIntegrador.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      Title="PDV Loja"
      Width="1400"
      Height="850"
     
      Background="#F3F4F6" HorizontalAlignment="Center" VerticalAlignment="Center">

    <Grid>

        <!-- DEFINIÇÃO DAS COLUNAS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <Border Background="#0F172A"
             Grid.Column="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <Border Background="#111827"
                     Height="90">

                    <StackPanel Orientation="Horizontal"
                             VerticalAlignment="Center"
                             Margin="25,0">

                        <Border Width="50"
                             Height="50"
                             CornerRadius="12"
                             Background="#22C55E">

                            <TextBlock Text="🛒"
                                    FontSize="26"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="PDV LOJA"
                                Foreground="White"
                                FontSize="34"
                                FontWeight="Bold"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- MENU -->
                <StackPanel Grid.Row="1"
                         Margin="10,10">

                    <!-- BOTÃO -->
                    <Button x:Name="BtnVendas" Content="🛒 Vendas" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnProdutos" Content="📦 Produtos" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnClientes" Content="👥 Clientes" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnEstoque" Content="🚚 Estoque" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnRelatorios" Content="📊 Relatórios" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnFinanceiro" Content="💲 Financeiro" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>
                    <Button x:Name="BtnConfiguracoes" Content="⚙️ Configurações" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="ShowMenu"/>

                    <!-- ITEM -->
                </StackPanel>
                <!-- Encerrar sistema -->
                <Button Margin="0,670,0,0" Grid.Row="1" Grid.RowSpan="2" Background="Red" Click="FecharSistema">

                    <StackPanel Orientation="Horizontal"
                             VerticalAlignment="Center"
                             Margin="30,0">

                        <TextBlock Text="⏻"
                                Foreground="White"
                                FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>

                        <TextBlock Text="Encerrar sistema"
                                Foreground="White"
                                FontSize="20"
                                Margin="15,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- CONTEÚDO -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Border Background="White"
                 Height="90"
                 BorderBrush="#E5E7EB"
                 BorderThickness="0,0,0,1">

                <Grid Margin="30,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Olá, Eduarda!"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="#111827"/>

                        <TextBlock Text="Bem-vindo ao sistema PDV"
                                FontSize="18"
                                Foreground="#6B7280"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                             Orientation="Horizontal"
                             VerticalAlignment="Center">

                        <Border Background="#DCFCE7"
                             Padding="18,10"
                             CornerRadius="20">

                            <TextBlock Text="● CAIXA ABERTO"
                                    Foreground="#16A34A"
                                    FontWeight="Bold"
                                    FontSize="18"/>
                        </Border>
                    </StackPanel>
                </Grid>

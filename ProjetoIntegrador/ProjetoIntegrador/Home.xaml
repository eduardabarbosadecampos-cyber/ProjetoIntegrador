<Page x:Class="ProjetoIntegrador.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ProjetoIntegrador"
      Title="PDV Loja"
      Width="1400"
      Height="850"
     
      Background="#F3F4F6" HorizontalAlignment="Center" VerticalAlignment="Center">

    <Grid>

        <!-- DEFINIÇÃO DAS COLUNAS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <Border Background="#0F172A"
             Grid.Column="0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <Border Background="#111827"
                     Height="90">

                    <StackPanel Orientation="Horizontal"
                             VerticalAlignment="Center"
                             Margin="25,0">

                        <Border Width="50"
                             Height="50"
                             CornerRadius="12"
                             Background="#22C55E">

                            <TextBlock Text="🛒"
                                    FontSize="26"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="PDV LOJA"
                                Foreground="White"
                                FontSize="34"
                                FontWeight="Bold"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- MENU -->
                <StackPanel Grid.Row="1"
                         Margin="10,10">

                    <!-- BOTÃO -->
                    <Button x:Name="BtnVendas" Content="🛒 Vendas" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="OpenMenu"/>
                    <Button x:Name="BtnProdutos" Content="📦 Produtos" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="OpenMenu"/>
                    <Button x:Name="BtnClientes" Content="👥 Clientes" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="OpenMenu"/>
                    <Button x:Name="BtnEstoque" Content="🚚 Estoque" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="OpenMenu"/>
                    <Button x:Name="BtnRelatorios" Content="📊 Relatórios" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="OpenMenu"/>
                    <Button x:Name="BtnFinanceiro" Content="💲 Financeiro" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="OpenMenu"/>
                    <Button x:Name="BtnConfiguracoes" Content="⚙️ Configurações" FontSize="30" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" Click="OpenMenu"/>

                    <!-- ITEM -->

                </StackPanel>


















                <!-- Encerrar sistema -->
                <Button Margin="0,670,0,0" Grid.Row="1" Grid.RowSpan="2" Background="Red" Click="Exit_Sistema_Click">

                    <StackPanel Orientation="Horizontal"
                             VerticalAlignment="Center"
                             Margin="30,0">

                        <TextBlock Text="⏻"
                                Foreground="White"
                                FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>

                        <TextBlock Text="Encerrar sistema"
                                Foreground="White"
                                FontSize="20"
                                Margin="15,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- CONTEÚDO -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Border Background="White"
                 Height="90"
                 BorderBrush="#E5E7EB"
                 BorderThickness="0,0,0,1">

                <Grid Margin="30,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Olá, Eduarda!"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="#111827"/>

                        <TextBlock Text="Bem-vindo ao sistema PDV"
                                FontSize="18"
                                Foreground="#6B7280"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                             Orientation="Horizontal"
                             VerticalAlignment="Center">

                        <Border Background="#DCFCE7"
                             Padding="18,10"
                             CornerRadius="20">

                            <TextBlock Text="● CAIXA ABERTO"
                                    Foreground="#16A34A"
                                    FontWeight="Bold"
                                    FontSize="18"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VENDAS -->
            <Canvas Background="White" Grid.Row="1" Height="760" VerticalAlignment="Center" HorizontalAlignment="Right" Width="1080">
                <Label Content="Cliente" Canvas.Left="77" Canvas.Top="16" Height="57" Width="110" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Rectangle Height="1" Stroke="Black" Canvas.Top="92" Width="1080" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <TextBox Canvas.Left="192" TextWrapping="Wrap" Text="Buscar Cliente" Canvas.Top="24" Width="204" Height="42" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="25"/>
                <Label Content="Produto" Canvas.Left="116" Canvas.Top="129" Height="57" Width="120" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Label Content="Quantidade" Canvas.Left="69" Canvas.Top="186" Height="57" Width="169" FontSize="30" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label Content="Desconto" Canvas.Left="92" Canvas.Top="241" Height="57" Width="144" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Label Content="Tamanho" Canvas.Left="618" Canvas.Top="129" Height="57" Width="132" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Label Content="Preço Unitário" Canvas.Left="551" Canvas.Top="186" Height="57" Width="199" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Label Content="Total" Canvas.Left="679" Canvas.Top="241" Height="57" Width="71" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <TextBox Canvas.Left="241" TextWrapping="Wrap" Text="" Canvas.Top="136" Width="204" Height="43" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <TextBox Canvas.Left="243" TextWrapping="Wrap" Text="" Canvas.Top="193" Width="204" Height="43" FontSize="25" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBox Canvas.Left="243" TextWrapping="Wrap" Text="" Canvas.Top="249" Width="204" Height="43" FontSize="25" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.534,-0.233"/>
                <TextBox Canvas.Left="755" TextWrapping="Wrap" Text="" Canvas.Top="136" Width="48" Height="43" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Label Content="Cor" Canvas.Left="848" Canvas.Top="129" Height="57" Width="58" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.592,0.558"/>
                <TextBox Canvas.Left="911" TextWrapping="Wrap" Text="" Canvas.Top="136" Width="48" Height="43" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="1.123,0.421"/>
                <TextBox Canvas.Left="755" TextWrapping="Wrap" Text="" Canvas.Top="191" Width="204" Height="43" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <TextBox Canvas.Left="755" TextWrapping="Wrap" Text="" Canvas.Top="248" Width="204" Height="43" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Button Content="Adicionar item" Canvas.Left="145" Canvas.Top="320" Height="40" Width="200" FontSize="25" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFBFFDE8" RenderTransformOrigin="0.525,0.3"/>
                <Button Content="Remover item" Canvas.Left="618" Canvas.Top="320" Height="40" Width="200" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#FFFFBEBE"/>
                <Label Content="+" Canvas.Left="102" Canvas.Top="313" Height="57" Width="30" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="2.796,0.488"/>
                <Label Content="-" Canvas.Left="591" Canvas.Top="313" Height="40" Width="22" FontSize="30" RenderTransformOrigin="2.796,0.488" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Rectangle Height="1" Stroke="Black" Canvas.Top="398" Width="1080" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Label Content="Itens no carrinho:" Canvas.Left="116" Canvas.Top="413" Height="57" Width="242" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Rectangle Height="1" Stroke="Black" Canvas.Top="486" Width="1080" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleY="-1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Label Content="Forma de Pagamento" Canvas.Left="98" Canvas.Top="508" Height="58" Width="294" FontSize="30" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBox Canvas.Left="409" TextWrapping="Wrap" Text="" Canvas.Top="516" Width="204" Height="42" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Label Content="Total Geral" Canvas.Left="237" Canvas.Top="566" Height="57" Width="154" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="❌ Cancelar" Canvas.Left="137" Canvas.Top="660" Height="54" Width="200" FontSize="25" Background="#FF22C55E" RenderTransformOrigin="0.525,0.3" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" Style="{StaticResource BotaoArredondado}" />
                <Button Content="✔ Finalizar Venda" Canvas.Left="706" Canvas.Top="662" Height="54" Width="253" FontSize="25" Background="#FF22C55E" RenderTransformOrigin="0.514,0.538" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource BotaoArredondado}" />

            </Canvas>


        </Grid>

    </Grid>
</Page>

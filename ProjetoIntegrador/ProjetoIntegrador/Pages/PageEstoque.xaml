<UserControl x:Class="ProjetoIntegrador.Pages.PageEstoque"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetoIntegrador.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Canvas x:Name="MenuEstoque"  Grid.RowSpan="2">

            <TextBlock Text="Controle de Estoque"
                   FontSize="24"
                   FontWeight="Bold"
                   Canvas.Left="286"
                   Canvas.Top="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>


            <!--Pesquisa-->

            <TextBox x:Name="txtPesquisar"
                 Width="250"
                 Height="30"
                 Canvas.Left="53"
                 Canvas.Top="69" HorizontalAlignment="Center" VerticalAlignment="Top"/>


            <!--Botão Pesquisar-->

            <Button x:Name="btnPesquisar"
                Content="Pesquisar"
                Width="100"
                Height="30"
                Background="#D9D9D9"
                Canvas.Left="332"
                Canvas.Top="69" HorizontalAlignment="Left" VerticalAlignment="Center"/>


            <!--Botão Atualizar Estoque-->

            <Button x:Name="btnAtualizar"
                Content="Atualizar Estoque"
                Width="140"
                Height="30"
                Background="#22C55E"
                Foreground="White"
                FontWeight="Bold"
                Canvas.Left="460"
                Canvas.Top="69" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <DataGrid x:Name="dgEstoque"
                          Width="800"
                          Height="294"
                          Canvas.Top="156"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" HorizontalAlignment="Left" VerticalAlignment="Center">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Produto"
                                            Binding="{Binding Produto}"
                                            Width="250"/>

                    <DataGridTextColumn Header="Tamanho"
                                            Binding="{Binding Tamanho}"
                                            Width="120"/>

                    <DataGridTextColumn Header="Cor"
                                            Binding="{Binding Cor}"
                                            Width="150"/>

                    <DataGridTextColumn Header="Qtd. Disponível"
                                            Binding="{Binding QuantidadeDisponivel}"
                                            Width="150"/>

                    <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="150"/>


                </DataGrid.Columns>

            </DataGrid>

        </Canvas>
    </Grid>
</UserControl>

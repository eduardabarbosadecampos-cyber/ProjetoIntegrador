<UserControl x:Class="ProjetoIntegrador.Pages.PageClientes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetoIntegrador.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1400" Background="White">

    <Grid x:Name="MenuClientes">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Clientes" Grid.Row="0" FontSize="24" FontWeight="Bold" Margin="10" />
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBox Width="300" Height="35" Text="Pesquisar cliente..." Margin="20"/>

            <Button Content="Pesquisar"
        Width="120"
        Height="35" Margin="10"/>

            <Button Content="Novo Cliente"
        Width="140"
        Height="35"
        Background="#2ECC71"
        Foreground="White" Margin="10"/>

            <Button Content="Editar"
                Width="140"
                Height="35"
                Background="#FFCACACA"
                Foreground="Black" Margin="10"/>

            <Button Content="Excluir"
                Width="134"
                Height="35"
                Background="#FFFB0000"
                Foreground="White" Margin="10"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
      AutoGenerateColumns="False"
      CanUserAddRows="False" HorizontalAlignment="Left" Canvas.Top="85" VerticalAlignment="Center" Canvas.Left="10" Width="868" Height="28" Margin="20,0,0,0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                        Binding="{Binding Id}"
                        Width="60"/>

                <DataGridTextColumn Header="Nome"
                        Binding="{Binding Nome}"
                        Width="250"/>

                <DataGridTextColumn Header="Telefone"
                        Binding="{Binding Telefone}"
                        Width="150"/>

                <DataGridTextColumn Header="CPF"
                        Binding="{Binding CPF}"
                        Width="150"/>

                <DataGridTextColumn Header="Cidade"
                        Binding="{Binding Cidade}"
                        Width="150"/>

                <DataGridTextColumn Header="Compras"
                        Binding="{Binding TotalCompras}"
                        Width="120"/>



            </DataGrid.Columns>

        </DataGrid>

        <Border Grid.Column="1" Width="216" Background="White" BorderBrush="#DDD" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">

            <StackPanel Margin="15">
                <TextBlock Text="Cliente Selecionado"
           FontSize="18"
           FontWeight="Bold"/>

                <TextBlock Text="Nome:"
           Margin="0,20,0,0"/>

                <TextBlock Text="CPF:"
           Margin="0,10,0,0"/>

                <TextBlock Text="Telefone:"
           Margin="0,10,0,0"/>

                <TextBlock Text="Cidade:"
           Margin="0,10,0,0"/>
            </StackPanel>

        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="ProjetoIntegrador.Pages.PageVendas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetoIntegrador.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1400">

    <!-- VENDAS -->
    <Grid Background="White">
        <WrapPanel Grid.Row="0" HorizontalAlignment="Left"/>

        <Canvas x:Name="MenuVendas" Background="White">
            <Grid Margin="15">

                <Grid.RowDefinitions>

                    <RowDefinition Height="70"/>
                    <RowDefinition Height="95"/>
                    <RowDefinition Height="95"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="45"/>

                </Grid.RowDefinitions>

                <!-- ========================= -->
                <!-- CABEÇALHO -->
                <!-- ========================= -->

                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="8"
                        Padding="15" Margin="0,-5,-304,0">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="350"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="🛒"
                                FontSize="28"
                                Foreground="#28A745"/>

                            <StackPanel Margin="10,0">

                                <TextBlock
                                    Text="PDV"
                                    FontWeight="Bold"
                                    FontSize="24"/>
                                <TextBlock
                                    Text="Sistema de Venda"
                                    Foreground="Gray"/>

                            </StackPanel>

                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                            <Border
                                Background="#E8F5E9"
                                CornerRadius="5"
                                Padding="15,8"
                                Margin="0,0,15,0">

                                <TextBlock
                                    Text="● CAIXA ABERTO"
                                    Foreground="#2E7D32"
                                    FontWeight="Bold"/>

                            </Border>

                            <TextBlock
                                Text="10:45"
                                FontSize="22"
                                Margin="10,0"/>

                            <TextBlock
                                Text="27/05/2024"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- ========================= -->
                <!-- CLIENTE / VENDEDOR -->
                <!-- ========================= -->

                <Border Grid.Row="1"
                        Margin="0,5,-304,58"
                        Background="White"
                        CornerRadius="8"
                        Padding="15" Grid.RowSpan="2">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                Text="Cliente (F3)"
                                FontWeight="Bold"/>

                            <DockPanel Margin="0,5">

                                <TextBox x:Name="tbCliente"
                                         Height="35"
                                         FontSize="15"
                                         VerticalContentAlignment="Center"
                                         Text="Consumidor Final"/>

                                <Button Width="40"
                                        Margin="5,0"
                                        Content="🔍"/>

                            </DockPanel>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="25,0,0,0"/>

                    </Grid>

                </Border>

                <!-- ========================= -->
                <!-- PRODUTO -->
                <!-- ========================= -->

                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="8"
                        Padding="15" Margin="0,20,-304,483" Grid.RowSpan="2">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="180"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                Text="Código do Produto"
                                FontWeight="Bold"/>

                            <TextBox x:Name="tbCodigo"
                                Margin="0,5"
                                Height="35"
                                Text=""/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0">

                            <TextBlock
                                Text="Quantidade"
                                FontWeight="Bold"/>

                            <TextBox x:Name="tbQtd"
                                Margin="0,5"
                                Height="35"
                                Text="1"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="15,0">

                            <TextBlock
                                Text="Desconto (%)"
                                FontWeight="Bold"/>

                            <TextBox x:Name="tbDesc"
                                Margin="0,5"
                                Height="35"
                                Text="0"/>

                        </StackPanel>

                        <Button Grid.Column="3"
                                Margin="20,2,0,0"
                                Background="#28A745"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="16"
                                Height="55"
                                Content="Adicionar Item"
                                Click="BtnAdicionar_Click"/>

                    </Grid>

                </Border>

                <!-- ========================= -->
                <!-- TABELA -->
                <!-- ========================= -->

                <Grid Grid.Row="3" Margin="0,10">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="707*"/>
                        <ColumnDefinition Width="96*"/>
                        <ColumnDefinition Width="280"/>

                    </Grid.ColumnDefinitions>

                    <Border
                        Background="White"
                        CornerRadius="8"
                        Margin="0,0,10,0" Grid.ColumnSpan="2">

                        <DataGrid x:Name="dgItens"
                            AutoGenerateColumns="False"
                            HeadersVisibility="Column"
                            CanUserAddRows="False" Margin="0,38,0,33">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Código" Width="80" Binding="{Binding Codigo}"/>

                                <DataGridTextColumn Header="Produto" Width="200" Binding="{Binding Produto}"/>

                                <DataGridTextColumn Header="Cor" Width="100" Binding="{Binding Cor}"/>

                                <DataGridTextColumn Header="Tam." Width="70" Binding="{Binding Tam}"/>

                                <DataGridTextColumn Header="Qtd." Width="60" Binding="{Binding Qtd}"/>

                                <DataGridTextColumn Header="Unitário" Width="100" Binding="{Binding Unitario, StringFormat=C}"/>

                                <DataGridTextColumn Header="Desc." Width="80" Binding="{Binding Desc, StringFormat={}{0}%}"/>

                                <DataGridTextColumn Header="Total" Width="100" Binding="{Binding Total, StringFormat=C}"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                    <!-- TOTAL -->

                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="8"
                            Padding="20" Margin="391,42,-290,-15" Grid.ColumnSpan="2">

                        <StackPanel Margin="0,0,0,158">

                            <TextBlock
                                Text="Subtotal:"
                                FontSize="18"/>

                            <TextBlock x:Name="txtSubtotal"
                                Text="R$ 0,00"
                                FontSize="22"
                                HorizontalAlignment="Right"/>

                            <Separator Margin="0,15"/>

                            <TextBlock
                                Text="Desconto:"
                                FontSize="18"/>

                            <TextBlock x:Name="txtDescontoTotal"
                                Text="R$ 0,00"
                                FontSize="22"
                                HorizontalAlignment="Right"/>

                            <Separator Margin="0,15"/>

                            <TextBlock
                                Text="TOTAL"
                                FontWeight="Bold"
                                FontSize="22"/>

                            <TextBlock x:Name="txtTotal"
                                Text="R$ 0,00"
                                FontSize="34"
                                FontWeight="Bold"
                                Foreground="#28A745"
                                HorizontalAlignment="Right"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- ========================= -->
                <!-- PAGAMENTO -->
                <!-- ========================= -->

                <Border Grid.Row="3"
                        Background="White"
                        CornerRadius="8"
                        Padding="15" Margin="0,455,-304,38" Grid.RowSpan="2">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="170"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Forma de Pagamento"/>

                            <ComboBox x:Name="cbPagamento" Height="35" SelectedIndex="0">

                                <ComboBoxItem>Dinheiro</ComboBoxItem>

                                <ComboBoxItem>PIX</ComboBoxItem>

                                <ComboBoxItem>Cartão</ComboBoxItem>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="15,0">

                            <TextBlock Text="Valor Recebido"/>

                            <TextBox x:Name="tbRecebido" Height="35" TextChanged="tbRecebido_TextChanged"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="15,0">

                            <TextBlock Text="Troco"/>

                            <TextBlock x:Name="txtTroco"
                                Text="R$ 0,00"
                                Foreground="#28A745"
                                FontSize="24"/>

                        </StackPanel>

                        <Button Grid.Column="4"
                                Background="#DC3545"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="18"
                                Margin="15"
                                Content="Cancelar Venda"
                                Click="BtnCancelar_Click"/>

                        <Button Grid.Column="5"
                                Background="#28A745"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="18"
                                Margin="15"
                                Content="Finalizar Venda"
                                Click="BtnFinalizar_Click"/>

                    </Grid>

                </Border>

                <!-- ========================= -->
                <!-- ATALHOS -->
                <!-- ========================= -->

            </Grid>

        </Canvas>

    </Grid>

</UserControl>

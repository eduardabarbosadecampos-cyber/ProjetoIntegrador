<UserControl x:Class="ProjetoIntegrador.Pages.PageVendas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetoIntegrador.Pages"
             mc:Ignorable="d" Width="1106" Height="762">

    <Canvas x:Name="MenuVendas" Background="White">
        <StackPanel Canvas.Left="10" Canvas.Top="10">
            <TextBlock
            Text="Cliente (F3)"
            FontWeight="Bold"/>
            <DockPanel Margin="0,5">
                <TextBox x:Name="tbCliente"
                     Height="35"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Text="Consumidor Final" Width="308"/>
                <Button Width="42"
                    Margin="5,0"
                    Content="🔍"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Canvas.Left="375" Canvas.Top="10" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock
            Text="Código do Produto"
            FontWeight="Bold"/>
            <TextBox x:Name="tbCodigo"
            Margin="0,5"
            Height="35"
            Text="" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel  Canvas.Left="494" Canvas.Top="10">
            <TextBlock
            Text="Quantidade"
            FontWeight="Bold"/>
            <TextBox x:Name="tbQtd"
            Margin="0,5"
            Height="35"
            Text="1" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel  Canvas.Left="572" Canvas.Top="10">
            <TextBlock
            Text="Desconto (%)"
            FontWeight="Bold"/>
            <TextBox x:Name="tbDesc"
            Margin="0,5"
            Height="35"
            Text="0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <Button
            Background="#28A745"
            Foreground="White"
            FontWeight="Bold"
            FontSize="16"
            Height="35"
            Content="Adicionar Item"
            Click="BtnAdicionar_Click" Canvas.Left="662" Canvas.Top="31" RenderTransformOrigin="0.616,0.873" HorizontalAlignment="Center" VerticalAlignment="Top" Width="140"/>

        <Border Background="White" CornerRadius="8" Canvas.Left="10" Canvas.Top="76" HorizontalAlignment="Center" Height="668" VerticalAlignment="Top">
            <DataGrid x:Name="dgItens"
            AutoGenerateColumns="False"
            HeadersVisibility="Column"
            CanUserAddRows="False" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Width="80" Binding="{Binding Codigo}"/>
                    <DataGridTextColumn Header="Produto" Width="200" Binding="{Binding Produto}"/>
                    <DataGridTextColumn Header="Cor" Width="100" Binding="{Binding Cor}"/>
                    <DataGridTextColumn Header="Tam." Width="70" Binding="{Binding Tam}"/>
                    <DataGridTextColumn Header="Qtd." Width="60" Binding="{Binding Qtd}"/>
                    <DataGridTextColumn Header="Unitário" Width="100" Binding="{Binding Unitario, StringFormat=C}"/>
                    <DataGridTextColumn Header="Desc." Width="80" Binding="{Binding Desc, StringFormat={}{0}%}"/>
                    <DataGridTextColumn Header="Total" Width="100" Binding="{Binding Total, StringFormat=C}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" Canvas.Left="830" Canvas.Top="76" HorizontalAlignment="Left" Height="668" VerticalAlignment="Center" Width="225">
            <StackPanel Margin="0,0,0,158">
                <TextBlock
                Text="Subtotal:"
                FontSize="18"/>
                <TextBlock x:Name="txtSubtotal"
                Text="R$ 0,00"
                FontSize="22"
                HorizontalAlignment="Right"/>
                <Separator Margin="0,15"/>
                <TextBlock
                Text="Desconto:"
                FontSize="18"/>
                <TextBlock x:Name="txtDescontoTotal"
                Text="R$ 0,00"
                FontSize="22"
                HorizontalAlignment="Right"/>
                <Separator Margin="0,15"/>
                <TextBlock
                Text="TOTAL"
                FontWeight="Bold"
                FontSize="22"/>
                <TextBlock x:Name="txtTotal"
                Text="R$ 0,00"
                FontSize="34"
                FontWeight="Bold"
                Foreground="#28A745"
                HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <StackPanel Canvas.Left="855" Canvas.Top="362" HorizontalAlignment="Center" VerticalAlignment="Top" Width="175">
            <TextBlock Text="Forma de Pagamento"/>
            <ComboBox x:Name="cbPagamento" Height="35" SelectedIndex="0">
                <ComboBoxItem Content="Dinheiro"/>
                <ComboBoxItem Content="PIX"/>
                <ComboBoxItem Content="Cartão"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Canvas.Left="857" Canvas.Top="437" HorizontalAlignment="Center" VerticalAlignment="Center" Width="173">
            <TextBlock Text="Valor Recebido"/>
            <TextBox x:Name="tbRecebido" Height="35" TextChanged="tbRecebido_TextChanged"/>
        </StackPanel>

        <StackPanel Canvas.Left="900" Canvas.Top="534" HorizontalAlignment="Left" VerticalAlignment="Center" Width="87">
            <TextBlock Text="Troco" FontSize="22"/>
            <TextBlock x:Name="txtTroco"
            Text="R$ 0,00"
            Foreground="#28A745"
            FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </StackPanel>

        <Button
             Background="#DC3545"
             Foreground="White"
             FontWeight="Bold"
             FontSize="18"
             Content="Cancelar Venda"
             Click="BtnCancelar_Click" Canvas.Left="875" Canvas.Top="632"/>

        <Button
            Background="#28A745"
            Foreground="White"
            FontWeight="Bold"
            FontSize="18"
            Content="Finalizar Venda"
            Click="BtnFinalizar_Click" Canvas.Left="876" Canvas.Top="687"/>
    </Canvas>
</UserControl>

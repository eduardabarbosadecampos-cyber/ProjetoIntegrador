<UserControl x:Class="ProjetoIntegrador.Pages.PageProdutos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetoIntegrador.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1400" Background="White">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="10">
            <Label Content="Código:"/>
            <TextBox x:Name="tbCodigoProd" Width="100"/>


            <Label Content="Descrição:"/>
            <TextBox x:Name="tbDescricao" Width="200"/>

            <Label Content="Gênero:"/>
            <ComboBox>
                <ComboBoxItem Content="M"/>
                <ComboBoxItem Content="F"/>
            </ComboBox>

            <Label Content="Tamanho:"/>
            <ComboBox>
                <ComboBoxItem Content="P"/>
                <ComboBoxItem Content="M"/>
                <ComboBoxItem Content="GG"/>
                <ComboBoxItem Content="XG"/>
            </ComboBox>

            <Label Content="Preço:"/>
            <TextBox x:Name="tbPreco" Width="100"/>

            <Label Content="Estoque:"/>
            <TextBox x:Name="tbEstoque" Width="200"/>

            <Button Content="Selecionar Imagem" Margin="2,0" Click="BtnSelecionarImagem_Click" Width="100"/>
            <TextBox Name="txtImgCaminho" IsReadOnly="True" Width="100"/>

            <Button Content="Cadastrar"  Margin="2,0" Click="BtnCadastrar_Click" Width="180"/>


        </WrapPanel>

        <WrapPanel Grid.Row="1" >
            <Border Width="180" Height="250" Background="White" CornerRadius="10" Margin="10" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <!--IMAGEM-->
                    <Image Height="150" Margin="10" Source="/download (1).jpg"/>

                    <!--NOME-->
                    <TextBlock Text="Swater de Tricot Listrado" FontWeight="Bold" FontSize="14" Margin="5" TextWrapping="Wrap" TextAlignment="Center"/>

                    <!--PREÇO-->
                    <TextBlock Text="R$ 200,50" FontSize="15" Foreground="Green" FontWeight="Bold" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Width="180"
                Height="250"
                Background="White"
                CornerRadius="10"
                Margin="10"
                BorderBrush="#DDD"
                BorderThickness="1">

                <StackPanel>

                    <Image Source="/How we got back on top.jpg"
                       Height="150"
                       Stretch="Uniform"
                       Margin="10"/>

                    <TextBlock Text="All Star Cano Alto Preto"
                           FontWeight="Bold"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="5"/>

                    <TextBlock Text="R$ 279,00"
                           Foreground="Green"
                           FontWeight="Bold"
                           FontSize="15"
                           TextAlignment="Center"/>

                </StackPanel>

            </Border>

            <Border Width="180"
                Height="250"
                Background="White"
                CornerRadius="10"
                Margin="10"
                BorderBrush="#DDD"
                BorderThickness="1">

                <StackPanel>

                    <Image Source="/moletom-vermelho_640x640+fill_ffffff.png"
                       Height="150"
                       Stretch="Uniform"
                       Margin="10"/>

                    <TextBlock Text="Moletom Vermelho"
                           FontWeight="Bold"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="5"/>

                    <TextBlock Text="R$ 100,90"
                           Foreground="Green"
                           FontWeight="Bold"
                           FontSize="15"
                           TextAlignment="Center"/>

                </StackPanel>

            </Border>

            <Border Width="180"
                Height="250"
                Background="White"
                CornerRadius="10"
                Margin="10"
                BorderBrush="#DDD"
                BorderThickness="1">

                <StackPanel>

                    <Image Source="/Prod_6.jpg"
                       Height="150"
                       Stretch="Uniform"
                       Margin="10"/>


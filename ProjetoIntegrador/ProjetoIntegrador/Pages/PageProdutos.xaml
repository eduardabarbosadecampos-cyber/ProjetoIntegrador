<UserControl x:Class="ProjetoIntegrador.Pages.PageProdutos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetoIntegrador.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1400" Background="White">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="10">
            <Label Content="Código:"/>
            <TextBox x:Name="tbCodigoProd" Width="50"/>


            <Label Content="Produto:"/>
            <TextBox x:Name="tbProduto" Width="200"/>

            <Label Content="Gênero:"/>
            <ComboBox>
                <ComboBoxItem Content="M"/>
                <ComboBoxItem Content="F"/>
            </ComboBox>

            <Label Content="Tamanho:"/>
            <ComboBox>
                <ComboBoxItem Content="P"/>
                <ComboBoxItem Content="M"/>
                <ComboBoxItem Content="GG"/>
                <ComboBoxItem Content="XG"/>
            </ComboBox>

            <Label Content="Preço:"/>
            <TextBox x:Name="tbPreco" Width="50"/>

            <Label Content="Estoque:"/>
            <TextBox x:Name="tbEstoque" Width="50"/>

            <Button Content="Selecionar Imagem" Margin="2,0" Click="BtnSelecionarImagem_Click" Width="100"/>

            <Button Content="Cadastrar"  Margin="2,0" Click="BtnCadastrar_Click" Width="180"/>
        </WrapPanel>

        <WrapPanel x:Name="gridProdutos" Grid.Row="1" >
        <!--Produto Adicionado via codigo-->
        </WrapPanel>
    </Grid>

</UserControl>

            </Border>

            <Border Width="180"
Height="250"
Background="White"
CornerRadius="10"
Margin="10"
BorderBrush="#DDD"
BorderThickness="1">

                <StackPanel>

                    <Image Source="/camisasocial.jpg"
       Height="150"
       Stretch="Uniform"
       Margin="10"/>

                    <TextBlock Text="Camisa Social"
           FontWeight="Bold"
           FontSize="14"
           TextAlignment="Center"
           Margin="5"/>

                    <TextBlock Text="R$ 59,99"

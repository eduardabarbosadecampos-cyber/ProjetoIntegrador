<UserControl x:Class="ProjetoIntegrador.Pages.PageConfigurações"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetoIntegrador.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Canvas>

            <!-- Painel Principal -->
            <Border Width="780"
                Height="430"
                Background="White"
                CornerRadius="20"
                Canvas.Left="10"
                Canvas.Top="10" HorizontalAlignment="Center" VerticalAlignment="Top">

                <Canvas>

                    <!-- Título -->
                    <TextBlock Text="CONFIGURAÇÕES"
                           FontSize="28"
                           FontWeight="Bold"
                           Canvas.Left="30"
                           Canvas.Top="10" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <!-- Dados da Loja -->
                    <TextBlock Text="Dados da Loja"
                           FontSize="20"
                           FontWeight="Bold"
                           Canvas.Left="30"
                           Canvas.Top="72" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <TextBlock Text="Nome da Loja:"
                           Canvas.Left="30"
                           Canvas.Top="130"/>

                    <TextBox Width="300"
                         Height="30"
                         Canvas.Left="150"
                         Canvas.Top="125"/>

                    <TextBlock Text="CNPJ:"
                           Canvas.Left="30"
                           Canvas.Top="172" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <TextBox Width="300"
                         Height="30"
                         Canvas.Left="150"
                         Canvas.Top="166" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <TextBlock Text="Telefone:"
                           Canvas.Left="30"
                           Canvas.Top="215" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBox Width="300"
                         Height="30"
                         Canvas.Left="150"
                         Canvas.Top="208" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <TextBlock Text="E-mail:"
                           Canvas.Left="30"
                           Canvas.Top="258" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <TextBox Width="300"
                         Height="30"
                         Canvas.Left="150"
                         Canvas.Top="251" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <!-- Sistema -->
                    <TextBlock Text="Sistema"
                           FontSize="20"
                           FontWeight="Bold"
                           Canvas.Left="29"
                           Canvas.Top="294" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                    <TextBlock Text="Tema:"
                           Canvas.Left="29"
                           Canvas.Top="341" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <ComboBox Width="200"
                          Height="30"
                          Canvas.Left="150"
                          Canvas.Top="334" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <ComboBoxItem Content="Claro"/>
                        <ComboBoxItem Content="Escuro"/>
                    </ComboBox>

                    <TextBlock Text="Idioma:"
                           Canvas.Left="30"
                           Canvas.Top="380" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <ComboBox Width="200"
                          Height="30"
                          Canvas.Left="150"
                          Canvas.Top="377" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <ComboBoxItem Content="Português"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>

                    <!-- Opções -->
                    <CheckBox Content="Abrir caixa automaticamente"
                          Canvas.Left="500"
                          Canvas.Top="130"/>

                    <CheckBox Content="Emitir comprovante após venda"
                          Canvas.Left="500"
                          Canvas.Top="180"/>

                    <!-- Botão -->
                    <Button Content="Salvar Alterações"
                        Width="200"
                        Height="40"
                        Background="#00C45F"
                        Foreground="White"
                        FontWeight="Bold"
                        Canvas.Left="488"
                        Canvas.Top="367" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                </Canvas>

            </Border>

        </Canvas>

    </Grid>
</UserControl>

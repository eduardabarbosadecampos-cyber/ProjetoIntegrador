<UserControl x:Class="ProjetoIntegrador.Pages.PageFinanceiro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetoIntegrador.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Canvas  Grid.Row="1">


            <!--Painel de filtros-->

            <Border Width="750"
                                Height="124"
                                Background="#22C55E"
                                CornerRadius="25"
                                Canvas.Left="25"
                                Canvas.Top="20" HorizontalAlignment="Left" VerticalAlignment="Center">

                <Canvas>

                    <TextBlock Text="Período"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Canvas.Left="30"
                                   Canvas.Top="20"/>

                    <DatePicker Width="220"
                                    Height="40"
                                    Canvas.Left="30"
                                    Canvas.Top="60"/>

                    <TextBlock Text="Movimentação"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Canvas.Left="288"
                                   Canvas.Top="20" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <ComboBox Width="220"
                                    Height="30"
                                    Canvas.Left="255"
                                    Canvas.Top="59" HorizontalAlignment="Center" VerticalAlignment="Top">

                        <ComboBoxItem Content="Todas"/>
                        <ComboBoxItem Content="Entradas"/>
                        <ComboBoxItem Content="Saídas"/>

                    </ComboBox>

                    <Button Content="Pesquisar"
                                Width="150"
                                Height="29"
                                Background="White"
                                Canvas.Left="518"
                                Canvas.Top="60" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                </Canvas>

            </Border>


            <!--Entradas-->


            <Border Width="212"
                        Height="143"
                        Background="White"
                        CornerRadius="20"
                        Canvas.Left="25"
                        Canvas.Top="165" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Canvas>

                    <Border Width="192"
                                Height="40"
                                Background="#22C55E"
                                CornerRadius="20"
                                Canvas.Left="10"
                                Canvas.Top="15" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <TextBlock Text="ENTRADAS"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Canvas.Left="59"
                                   Canvas.Top="24" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <TextBlock Text="R$ 0,00"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Canvas.Left="43"
                                   Canvas.Top="72" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                </Canvas>
            </Border>


            <!--Saídas-->

            <Border Width="212"
                Height="143"
                Background="White"
                CornerRadius="20"
                Canvas.Left="294"
                Canvas.Top="164" HorizontalAlignment="Center" VerticalAlignment="Top">

                <Canvas>

                    <Border Width="192"
                        Height="39"
                        Background="#FF6B6B"
                        CornerRadius="20"
                        Canvas.Left="10"
                        Canvas.Top="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <TextBlock Text="SAÍDAS"
                           FontSize="17"
                           FontWeight="Bold"
                           Canvas.Left="76"
                           Canvas.Top="24" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                    <TextBlock Text="R$ 0,00"
                           FontSize="30"
                           FontWeight="Bold"
                           Canvas.Left="43"
                           Canvas.Top="72" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                </Canvas>

            </Border>


            <!--Lucro-->

            <Border Width="212"
                Height="147"
                Background="White"
                CornerRadius="20"
                Canvas.Left="541"
                Canvas.Top="165" HorizontalAlignment="Left" VerticalAlignment="Center">

                <Canvas>

                    <Border Width="192"
                        Height="37"
                        Background="#00C45F"
                        CornerRadius="20"
                        Canvas.Left="10"
                        Canvas.Top="15" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <TextBlock Text="LUCRO"
                           FontSize="17"
                           FontWeight="Bold"
                           Canvas.Left="78"
                           Canvas.Top="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <TextBlock Text="R$ 0,00"
                           FontSize="30"
                           FontWeight="Bold"
                           Canvas.Left="68"
                           Canvas.Top="74" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                </Canvas>

            </Border>


            <!--Tabela-->

            <DataGrid Width="800"
                  Height="138"
                  Canvas.Top="312"
                  AutoGenerateColumns="False" HorizontalAlignment="Center" VerticalAlignment="Top">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Data"
                                    Binding="{Binding Data}"
                                    Width="100"/>

                    <DataGridTextColumn Header="Descrição"
                                    Binding="{Binding Descricao}"
                                    Width="270"/>

                    <DataGridTextColumn Header="Tipo"
                                    Binding="{Binding Tipo}"
                                    Width="130"/>

                    <DataGridTextColumn Header="Valor"
                                    Binding="{Binding Valor}"
                                    Width="150"/>

                    <DataGridTextColumn Header="Forma Pagamento"
                                    Binding="{Binding Pagamento}"
                                    Width="150"/>

                </DataGrid.Columns>

            </DataGrid>



        </Canvas>

    </Grid>


</UserControl>
